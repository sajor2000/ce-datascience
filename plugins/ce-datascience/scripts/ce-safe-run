#!/usr/bin/env python3
"""Run a command that may print data values, without showing its output.

Usage: ce-safe-run -- <command> [args...]

Full stdout and stderr go to .ce-datascience/runs/<UTC-timestamp>-<pid>.log in
the project (gitignored). The terminal gets only the exit code, the duration,
the log path, the files created or modified under the project (path, size,
and row count for tabular files), and the last 30 lines of stderr with quoted
literals, digit runs of 4 or more, emails, phones, and SSNs masked. Traceback
file/line frames stay readable. Stdout is never printed. The exit code is the
command's.
"""

import os
import re
import subprocess
import sys
import time

SKIP_DIRS = {".git", ".ce-datascience", "node_modules", ".venv", "venv", "__pycache__", ".mypy_cache",
             ".pytest_cache", ".ruff_cache", ".quarto", "renv", ".Rproj.user"}
TABULAR = (".csv", ".tsv", ".psv", ".tab")
MAX_FILES = 20000
MAX_LISTED = 50
TAIL_LINES = 30
FRAME = re.compile(r'^(\s*File "[^"\n]+", line \d+(?:, in [\w<>.]+)?)(.*)$')
MASKS = (
    (re.compile(r"'[^'\n]*'"), "'…'"),
    (re.compile(r'"[^"\n]*"'), '"…"'),
    (re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}"), "[email]"),
    (re.compile(r"(?<!\d)\d{3}-\d{2}-\d{4}(?!\d)"), "[ssn]"),
    (re.compile(r"(?:\+?1[-. ]?)?(?:\(\d{3}\)\s?|\d{3}[-. ])\d{3}[-. ]\d{4}(?!\d)"), "[phone]"),
    (re.compile(r"\d{4,}"), "####"),
)


def project_root(start):
    probe = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(probe, ".ce-datascience")) or os.path.exists(os.path.join(probe, ".git")):
            return probe
        parent = os.path.dirname(probe)
        if parent == probe:
            return os.path.abspath(start)
        probe = parent


def snapshot(root):
    """{relative path: (mtime_ns, size)} for project files, skipping tool and VCS directories."""
    files = {}
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for name in filenames:
            full = os.path.join(dirpath, name)
            try:
                st = os.stat(full)
            except OSError:
                continue
            files[os.path.relpath(full, root)] = (st.st_mtime_ns, st.st_size)
            if len(files) >= MAX_FILES:
                return files
    return files


def row_count(path):
    lower = path.lower()
    try:
        if lower.endswith(TABULAR):
            with open(path, "rb") as fh:
                lines = sum(1 for line in fh if line.strip())
            return max(lines - 1, 0)
        if lower.endswith(".parquet"):
            import pyarrow.parquet as pq
            return pq.ParquetFile(path).metadata.num_rows
    except Exception:  # row counts are best effort
        return None
    return None


def changes(before, after, root):
    lines = []
    for rel in sorted(after):
        if before.get(rel) == after[rel]:
            continue
        kind = "created " if rel not in before else "modified"
        rows = row_count(os.path.join(root, rel))
        line = f"  {kind} {rel}  {after[rel][1]} bytes"
        lines.append(line + (f"  {rows} rows" if rows is not None else ""))
    return lines


def mask(text):
    for pattern, replacement in MASKS:
        text = pattern.sub(replacement, text)
    return text


def masked_tail(err):
    lines = err.decode("utf-8", errors="replace").splitlines()[-TAIL_LINES:]
    out = []
    for line in lines:
        frame = FRAME.match(line)
        out.append(frame.group(1) + mask(frame.group(2)) if frame else mask(line))
    return out


def main(argv):
    if "--" not in argv or argv.index("--") == len(argv) - 1:
        print(__doc__.strip())
        return 2
    cmd = argv[argv.index("--") + 1:]
    root = project_root(os.getcwd())
    runs = os.path.join(root, ".ce-datascience", "runs")
    os.makedirs(runs, exist_ok=True)
    name = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + f"-{os.getpid()}.log"
    log_path = os.path.join(runs, name)
    before = snapshot(root)
    start = time.monotonic()
    try:
        proc = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True)
        code, out, err = proc.returncode, proc.stdout, proc.stderr
    except OSError as exc:
        code, out, err = 127, b"", f"ce-safe-run: could not start the command ({type(exc).__name__})\n".encode()
    duration = time.monotonic() - start
    fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as fh:
        fh.write(b"== command ==\n" + " ".join(cmd).encode() + b"\n== stdout ==\n" + out + b"\n== stderr ==\n" + err)
    print(f"ce-safe-run: exit code: {code}, duration: {duration:.1f}s")
    print(f"Full stdout and stderr (not shown): {os.path.relpath(log_path, root)}")
    changed = changes(before, snapshot(root), root)
    print("Files created or modified:" if changed else "Files created or modified: none")
    for line in changed[:MAX_LISTED]:
        print(line)
    if len(changed) > MAX_LISTED:
        print(f"  ... and {len(changed) - MAX_LISTED} more")
    tail = masked_tail(err)
    if tail:
        print(f"stderr (last {TAIL_LINES} lines, masked):")
        for line in tail:
            print("  " + line)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

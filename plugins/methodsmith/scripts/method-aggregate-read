#!/usr/bin/env python3
"""Print aggregate tables that pass the aggregate check.

Usage: method-aggregate-read <table.csv|table.tsv|table.md> [...]

Each file must be a .csv, .tsv, or .md under an aggregate directory
(phi_environment.aggregate_dirs, default output/, results/,
analysis/publication/, analysis/sap-tables/) and outside data_root. The file is
read once; those bytes are checked (no identifier headings, identifier-shaped or
indexed cells, counts from 1 to 10, or more than 500 rows) and printed only if
they pass, so a file swapped after a hook-time check cannot be printed. A
failing file prints the rule it broke, never a value, and the exit code is 1.
The check is the boundary guard's own (hooks/data-boundary-guard.py).
"""

import importlib.util
import os
import sys

GUARD = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks", "data-boundary-guard.py")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 2
    spec = importlib.util.spec_from_file_location("data_boundary_guard", GUARD)
    guard = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(guard)
    cwd, status = os.getcwd(), 0
    for raw in argv:
        mode = guard.resolve_mode({"cwd": cwd, "tool_input": {"file_path": raw}})
        try:
            problem, text = guard.read_aggregate(raw, cwd, mode)
        except OSError as exc:
            problem, text = f"it cannot be read ({type(exc).__name__})", None
        if problem:
            print(f"method-aggregate-read: {raw} not printed: {problem}", file=sys.stderr)
            status = 1
            continue
        if len(argv) > 1:
            print(f"==> {raw} <==")
        sys.stdout.write(text)
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
